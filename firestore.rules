rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /settings/{id} { allow read: if id == 'public'; allow write: if false; }
    match /instruments/{id} { allow read: if true; allow write: if false; }
    match /tallies/{instrumentId}/shards/{shardId} { allow read: if true; allow write: if false; }
    match /roles/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
